<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <!-- ॲपचे नाव -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mindful Digest"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="20dp" />

    <!-- प्रोफाइल कार्ड -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="👤"
            android:textSize="30sp"
            android:gravity="center"
            android:background="#E0E0E0" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Profile"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="डिटॉक्स मोड: ॲक्टिव्ह"
                android:textSize="14sp"
                android:textColor="#4CAF50" />
        </LinearLayout>
    </LinearLayout>

    <!-- समरी कार्ड -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="आजचा सारांश (Digest)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/tvNotificationCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="शांतता चालू आहे. अनावश्यक नोटिफिकेशन्स थांबवली आहेत."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- डिटॉक्स बटण -->
    <Button
        android:id="@+id/btnToggleDetox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="डिटॉक्स चालू ठेवा"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

</LinearLayout>
